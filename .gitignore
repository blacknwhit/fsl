# Backup exclusions: generated artifacts, models, datasets, environments, caches, and secrets

# Checkpoints and model weights
*.ckpt
*.pth
*.pt
*.safetensors
*.onnx
*.h5
*.hdf5
*.tflite
*.engine
*.gguf
*.pb
**/checkpoint-*/
**/checkpoints/
**/Checkpoints/

# Local datasets, pretrained models, and Conda installation
/data/
/pretrained/
/miniconda3/
.venv/
venv/
.conda/
**/site-packages/

# Keep reproducibility logs/configs from all run trees, exclude generated payloads
**/runs/**
!**/runs/**/
!**/runs/**/*.log
!**/runs/**/*.txt
!**/runs/**/*.json
!**/runs/**/*.jsonl
!**/runs/**/*.yaml
!**/runs/**/*.yml
!**/runs/**/*.toml
!**/runs/**/*.csv
!**/runs/**/*.tsv
!**/runs/**/*.sh
!**/runs/**/*.py
**/runs/**/predictions*.json
**/runs/**/instances*.json
**/runs/**/detections*.json

# Caches and generated tracker payloads
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
**/.cache/
*.egg-info/
**/wandb/
**/.wandb/
**/events.out.tfevents.*

# Generated media, archives, and dataset-like binaries
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
*.npy
*.npz
*.parquet
*.arrow
Miniconda*.sh

# Sensitive local files
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
**/id_rsa
**/id_rsa.pub
**/id_ed25519
**/id_ed25519.pub
**/credentials.json
**/service_account*.json
**/*secret*.json
**/*secrets*.yaml
**/*secrets*.yml

# OS/editor and temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
**/.git.codex-backup-hold/
